{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "esnext",
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react-native": ["node_modules/@types/react-native"]
    }
  },
  "exclude": ["node_modules"]
}
