# ==========================================
# BACKEND SETTINGS (Django)
# ==========================================
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE CONFIG (PostgreSQL in Docker)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/varahi_db

# REDIS CONFIG (Redis in Docker)
REDIS_URL=redis://localhost:6379/0

# THIRD-PARTY API KEYS
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
JWT_SECRET_KEY=your_jwt_secret_key_here

# OBJECT STORAGE (AWS S3 or Cloudflare R2)
AWS_S3_ACCESS_KEY_ID=your_s3_key_id
AWS_S3_SECRET_ACCESS_KEY=your_s3_secret_key
AWS_S3_BUCKET_NAME=varahi-media

# BUSINESS SETTINGS
OWNER_UPI_ID=owner@ybl
OWNER_PAYEE_NAME=Varahi Capital

# ==========================================
# OWNER DASHBOARD SETTINGS (Next.js)
# ==========================================
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DJANGO_API_URL=http://localhost:8000/api/v1

# ==========================================
# SUPERVISOR DASHBOARD SETTINGS (Next.js)
# ==========================================
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
DJANGO_API_URL=http://localhost:8000/api/v1

# ==========================================
# MOBILE APP SETTINGS (Expo Go)
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
